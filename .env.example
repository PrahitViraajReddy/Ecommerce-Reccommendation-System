# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# SMTP (Gmail requires an App Password, not your normal account password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# SERP API (optional)
SERPAPI_API_KEY=

# LLM provider (optional; OpenAI-compatible endpoint)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# Existing model/data paths (optional)
RECOMMENDER_MODEL_PATH=
PRODUCT_DATASET_PATH=
